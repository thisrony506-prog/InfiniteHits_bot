<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.BubbleBlast" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/surface_card</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/surface_panel</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/accent_pink</item>
        <item name="colorSurface">@color/surface_panel</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_soft</item>
        <item name="colorError">@color/danger_red</item>
        <item name="android:colorBackground">@color/bg_deep</item>

        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BubbleBlast.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.BubbleBlast.Activity</item>
    </style>

    <!-- Splash uses a dedicated background so there is no flash of white. -->
    <style name="Theme.BubbleBlast.Splash" parent="Theme.BubbleBlast">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- Fullscreen-ish gameplay: darker system bars, no window animation. -->
    <style name="Theme.BubbleBlast.Game" parent="Theme.BubbleBlast">
        <item name="android:windowBackground">@color/bg_deep</item>
    </style>

    <!-- ============ Dialogs ============ -->
    <style name="ThemeOverlay.BubbleBlast.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_green</item>
    </style>

    <style name="Dialog.BubbleBlast" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.BubbleBlast.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Animation.BubbleBlast.Dialog" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_pop_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_pop_out</item>
    </style>

    <style name="Animation.BubbleBlast.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_fade_out</item>
    </style>

    <!-- ============ Text appearances ============ -->
    <style name="TextAppearance.BubbleBlast.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="TextAppearance.BubbleBlast.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BubbleBlast.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BubbleBlast.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.BubbleBlast.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Widget.BubbleBlast.Button.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
    </style>

    <style name="Widget.BubbleBlast.Button.Secondary" parent="Widget.BubbleBlast.Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_height">@dimen/button_height_small</item>
    </style>

    <style name="Widget.BubbleBlast.Button.Ghost" parent="Widget.BubbleBlast.Button.Primary">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_height">@dimen/button_height_small</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.BubbleBlast.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="Widget.BubbleBlast.Pill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
    </style>

    <style name="Widget.BubbleBlast.Panel" parent="">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">@dimen/space_lg</item>
    </style>

    <style name="Widget.BubbleBlast.LevelTile" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_level_unlocked</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
