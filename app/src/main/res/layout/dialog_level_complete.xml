<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/complete_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        style="@style/TextAppearance.BubbleBlast.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/level_complete_title" />

    <TextView
        android:id="@+id/complete_new_best_text"
        style="@style/TextAppearance.BubbleBlast.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/level_complete_new_best"
        android:textColor="@color/accent_gold"
        android:visibility="invisible" />

    <!-- Stars -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/complete_star_1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_star_empty"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/complete_star_2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/cd_star_empty"
            android:src="@drawable/ic_star_empty" />

        <ImageView
            android:id="@+id/complete_star_3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/cd_star_empty"
            android:src="@drawable/ic_star_empty" />
    </LinearLayout>

    <!-- Score / coins summary -->
    <LinearLayout
        style="@style/Widget.BubbleBlast.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.BubbleBlast.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/level_complete_score" />

            <TextView
                android:id="@+id/complete_score_text"
                style="@style/TextAppearance.BubbleBlast.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.BubbleBlast.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/level_complete_best" />

            <TextView
                android:id="@+id/complete_best_text"
                style="@style/TextAppearance.BubbleBlast.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:background="@color/stroke_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_coin" />

            <TextView
                style="@style/TextAppearance.BubbleBlast.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/level_complete_coins" />

            <TextView
                android:id="@+id/complete_coins_text"
                style="@style/TextAppearance.BubbleBlast.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/complete_double_button"
        style="@style/Widget.BubbleBlast.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/level_complete_double"
        android:textColor="@color/accent_gold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/complete_next_button"
        style="@style/Widget.BubbleBlast.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/level_complete_next" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/complete_replay_button"
            style="@style/Widget.BubbleBlast.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/level_complete_replay" />

        <TextView
            android:id="@+id/complete_home_button"
            style="@style/Widget.BubbleBlast.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/level_complete_home" />
    </LinearLayout>
</LinearLayout>
