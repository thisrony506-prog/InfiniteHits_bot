<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <com.infinitehits.bubbleblast.ui.view.BubbleFieldView
        android:id="@+id/home_bubbles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <!-- ============ Top bar ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/home_coins_button"
                style="@style/Widget.BubbleBlast.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_coins_pill"
                android:clickable="true"
                android:contentDescription="@string/cd_coin"
                android:focusable="true"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/home_coins_text"
                    style="@style/TextAppearance.BubbleBlast.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textSize="@dimen/text_subtitle"
                    android:text="@string/home_coins" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plus_circle" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/home_sound_button"
                style="@style/Widget.BubbleBlast.IconButton"
                android:contentDescription="@string/home_sound"
                android:src="@drawable/ic_sound_on" />

            <ImageButton
                android:id="@+id/home_music_button"
                style="@style/Widget.BubbleBlast.IconButton"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/home_music"
                android:src="@drawable/ic_music_on" />

            <ImageButton
                android:id="@+id/home_settings_button"
                style="@style/Widget.BubbleBlast.IconButton"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_gear" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ============ Logo ============ -->
        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/home_title"
            style="@style/TextAppearance.BubbleBlast.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/app_name" />

        <LinearLayout
            android:id="@+id/home_stars_pill"
            style="@style/Widget.BubbleBlast.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/home_stars_text"
                style="@style/TextAppearance.BubbleBlast.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textSize="@dimen/text_subtitle"
                android:text="@string/home_total_stars" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ============ Daily reward ============ -->
        <LinearLayout
            android:id="@+id/home_daily_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_daily_button"
            android:clickable="true"
            android:contentDescription="@string/cd_daily"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:contentDescription="@null"
                android:src="@drawable/ic_gift" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_daily_label"
                    style="@style/TextAppearance.BubbleBlast.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_daily"
                    android:textSize="@dimen/text_subtitle" />

                <TextView
                    android:id="@+id/home_daily_subtitle"
                    style="@style/TextAppearance.BubbleBlast.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_daily_ready"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <View
                android:id="@+id/home_daily_badge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_badge"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ Main buttons ============ -->
        <TextView
            android:id="@+id/home_play_button"
            style="@style/Widget.BubbleBlast.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:contentDescription="@string/cd_play"
            android:text="@string/home_play"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/home_levels_button"
            style="@style/Widget.BubbleBlast.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:contentDescription="@string/cd_levels"
            android:text="@string/home_levels" />

        <TextView
            android:id="@+id/home_version_text"
            style="@style/TextAppearance.BubbleBlast.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/app_name" />
    </LinearLayout>
</FrameLayout>
