<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Decorative bubbles drifting upwards -->
    <com.infinitehits.bubbleblast.ui.view.BubbleFieldView
        android:id="@+id/splash_bubbles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/splash_title"
            style="@style/TextAppearance.BubbleBlast.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/splash_tagline"
            style="@style/TextAppearance.BubbleBlast.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/app_tagline" />

        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/space_xxl"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar"
            tools:progress="45" />

        <TextView
            android:id="@+id/splash_status"
            style="@style/TextAppearance.BubbleBlast.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/splash_loading" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_version"
        style="@style/TextAppearance.BubbleBlast.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_lg"
        android:text="@string/splash_loading" />
</FrameLayout>
